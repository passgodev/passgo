    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    server {
        listen 80;
        server_name localhost 127.0.0.1 passgo.local _;
        return 301 https://$host:8443$request_uri;
    }

# https://serverfault.com/questions/577370/how-can-i-use-environment-variables-in-nginx-conf
# env variables
    server {
        listen 443 ssl default_server;
        server_name localhost 127.0.0.1 passgo.local _;

        ssl_certificate /etc/nginx/ssl/passgo.local.pem;
        ssl_certificate_key /etc/nginx/ssl/passgo.local-key.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        # bo przy pierwszym redirect, przegladarka ma https:8443

        location / {
            #proxy_pass http://host.docker.internal:8080; # nazwa usługi z docker-compose
            proxy_pass http://${BACKEND_SERVICE_NAME}:${BACKEND_CONTAINER_PORT}; # nazwa usługi z docker-compose
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
